+void PartTest::testAutoReloadAfterDeleteAndRecreate_data()
+{
+    QTest::addColumn<int>("gapMs");
+
+    QTest::newRow("rapid") << 0;
+    QTest::newRow("delayed") << 1100;
+}
+
+void PartTest::testAutoReloadAfterDeleteAndRecreate()
+{
+    QFETCH(int, gapMs);
+
+    const QTemporaryDir tempDir;
+    QVERIFY(tempDir.isValid());
+    const QString livePdf = QDir(tempDir.path()).filePath(QStringLiteral("live.pdf"));
+    const QString singlePagePdf = QStringLiteral(KDESRCDIR "data/file1.pdf");
+    const QString multiPagePdf = QStringLiteral(KDESRCDIR "data/simple-multipage.pdf");
+    QVERIFY(QFile::copy(singlePagePdf, livePdf));
+
+    Okular::Part part(nullptr, {});
+    QVERIFY(openDocument(&part, livePdf));
+    part.setWatchFileModeEnabled(true);
+    QVERIFY(part.isWatchFileModeEnabled());
+    QCOMPARE(part.m_document->pages(), 1u);
+    const QUrl liveUrl = QUrl::fromLocalFile(livePdf);
+
+    const QList<std::pair<QString, uint>> replacements = { { multiPagePdf, 40u }, { singlePagePdf, 1u }, { multiPagePdf, 40u } };
+    for (const auto &[replacement, expectedPages] : replacements) {
+        const uint oldPageCount = part.m_document->pages();
+        QVERIFY(QFile::remove(livePdf));
+        if (gapMs > 0) {
+            QTest::qWait(gapMs);
+            QCOMPARE(part.m_document->pages(), oldPageCount);
+        }
+        QVERIFY(QFile::copy(replacement, livePdf));
+        QTRY_COMPARE_WITH_TIMEOUT(part.m_document->pages(), expectedPages, 10000);
+        QVERIFY(part.m_document->isOpened());
+        QCOMPARE(part.url(), liveUrl);
+    }
+}
